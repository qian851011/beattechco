# Local development only (used by `npm run dev:functions`, which reads .dev.vars).
# Copy this file to .dev.vars and fill in the values.
# Production: set these in Cloudflare Pages -> Settings -> Variables and Secrets
# (mark NOTION_API_KEY as a Secret; set both Production and Preview).
# Never prefix these with VITE_ — that would bundle them into the public frontend.

# NOTION CMS INTEGRATION:
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Copy the "Internal Integration Secret" (starts with secret_ or ntn_) -> NOTION_API_KEY
# 3. Create your News Database in Notion (Title, Subtitle, Date, Category, Published)
# 4. In Notion, click "..." on the top right of the database -> "Connections" -> Add your integration!
# 5. Copy the database ID from the database URL: notion.so/<workspace>/<database_id>?v=... -> NOTION_DATABASE_ID
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# DEDICATED LEGAL & POLICY DATABASE (optional):
# A separate Notion database for 隱私權保護政策、平台服務條款、Cookie使用聲明、會員權益與須知
# Add your integration connection to it, and put its 32-character database ID here:
NOTION_LEGAL_DATABASE_ID=""
